generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN // Department Chairperson (CAS) — GEC/GEL + CAS majors, schedule approve/reject
  ADMIN       // Program Chairperson — their own program's major subjects
  FACULTY     // Record-only stub — cannot sign in
  DEAN        // One per department — approves that department's accounts, reads System Logs
  PATHFIT     // Single PATHFit coordinator account — generates/edits PATHFit entries everywhere
  NSTP        // Single NSTP coordinator account — edits NSTP entries everywhere
}

enum SubjectType {
  LECTURE
  LABORATORY
}

// Employment type of a faculty member — decides the weekly unit cap
// (lib/faculty-types.ts): REGULAR carries at most 21 units, COSI (Contract of
// Service Instructor) at most 40. Faculty.maxUnitsPerWeek is always derived
// from it on write; it is stored so the engine/validators need no lookup.
enum FacultyType {
  REGULAR
  COSI
}

enum RoomType {
  LECTURE_ROOM
  LABORATORY
  COMPUTER_LAB
  LECTURE_LAB
}

// Explicit academic specialization categories for laboratory rooms.
// A subject with a requiredLabSpecialization can ONLY be assigned to a room
// whose labSpecialization matches exactly — this is a Hard Constraint.
enum LabSpecialization {
  CISCO_NETWORKING
  MULTIMEDIA_DESIGN
  SOFTWARE_DEVELOPMENT
  GENERAL_COMPUTING
  ELECTRONICS
  NETWORK_SECURITY
  DATABASE_ADMINISTRATION
  WEB_DEVELOPMENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ScheduleStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum SemesterType {
  FIRST
  SECOND
  SUMMER
}

// Tracks the sequential submission lifecycle for a department/semester pair.
// The backtracking algorithm is locked behind SUBMITTED_TO_CHAIR.
enum DepartmentWorkflowStatus {
  DRAFT           // Program Chair is still inputting/configuring data
  SUBMITTED_TO_CHAIR // Program Chair has submitted; Department Chair can now process
  UNDER_REVIEW    // Department Chair is actively reviewing before running algorithm
  APPROVED        // Department Chair approved; schedule is official
  REJECTED        // Returned to Program Chair for revision with a note
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String          @id @default(cuid())
  supabaseId   String          @unique
  email        String?         @unique
  firstName    String
  lastName     String
  role         UserRole        @default(FACULTY)
  isApproved   Boolean         @default(false)
  isActive     Boolean         @default(true)
  departmentId String?
  // Faculty cluster this SUPER_ADMIN is scoped to (null = access all clusters)
  clusterId    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  department      Department?      @relation(fields: [departmentId], references: [id])
  cluster         FacultyCluster?  @relation(fields: [clusterId], references: [id])
  faculty         Faculty?
  departmentChair DepartmentChair?
  programHead     ProgramHead?
}

model College {
  id           String           @id @default(cuid())
  name         String           @unique
  abbreviation String           @unique
  departments  Department[]
  clusters     FacultyCluster[]
}

model Department {
  id           String          @id @default(cuid())
  name         String
  abbreviation String
  collegeId    String
  // Which faculty cluster this department belongs to (drives SUPER_ADMIN scoping)
  clusterId    String?

  college        College                   @relation(fields: [collegeId], references: [id])
  cluster        FacultyCluster?           @relation(fields: [clusterId], references: [id])
  chair          DepartmentChair?
  users          User[]
  programs       Program[]
  faculty        Faculty[]
  subjects       Subject[]
  schedules      Schedule[]
  buildings      DepartmentBuilding[]
  rooms          DepartmentRoom[]
  workflowStates DepartmentWorkflowState[]

  @@unique([abbreviation, collegeId])
}

// Groups departments into academic divisions (e.g. "Social Sciences Faculty").
// A SUPER_ADMIN assigned to a cluster can only see/approve data from
// departments in that cluster.
model FacultyCluster {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  collegeId   String?  // optional: a cluster can span the whole college
  createdAt   DateTime @default(now())

  college     College?     @relation(fields: [collegeId], references: [id])
  departments Department[]
  supervisors User[]       // SUPER_ADMINs assigned to this cluster
  programs    Program[]    // programs that belong to this cluster
  faculty     Faculty[]    // faculty members assigned to this cluster
  gecFinalizations GecFinalization[]
}

// One row per (schedule, CAS cluster) that cluster's chairperson has declared
// their GEC/GEL scheduling COMPLETE for this schedule (spec: "the three
// department chairpersons handling GEC/GEL must complete their scheduling
// before their schedules become visible to the program chairpersons"). A
// non-CAS department's schedule unlocks Program Chairperson actions (Add Entry,
// Generate, Submit — beyond the CIT labs-only pre-plot) only once EVERY
// FacultyCluster has a row here for that schedule — see
// lib/services/workflow-gates.ts `isGecFinalized`. Re-generating or manually
// editing a GEC/GEL entry for that cluster in this schedule deletes the row
// again (the declaration is stale the moment the underlying entries change).
model GecFinalization {
  id          String   @id @default(cuid())
  scheduleId  String
  clusterId   String
  finalizedBy String
  finalizedAt DateTime @default(now())

  schedule Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  cluster  FacultyCluster @relation(fields: [clusterId], references: [id])

  @@unique([scheduleId, clusterId])
  @@index([scheduleId])
}

// One row per (schedule, program) whose Program Chairperson has declared they
// are DONE plotting their program's subjects in this schedule. A department's
// schedule can be submitted for the Dean's approval only once every program of
// the department that has an approved Program Chairperson has a row here (and
// GEC/GEL is finalized) — see lib/services/workflow-gates.ts
// `getProgramFinalizationStatus`. Adding, editing or deleting a class (or
// regenerating) as that Program Chairperson deletes the row again, so the
// declaration always reflects the classes actually placed.
model ProgramFinalization {
  id          String   @id @default(cuid())
  scheduleId  String
  programId   String
  finalizedBy String
  finalizedAt DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, programId])
  @@index([scheduleId])
}

model DepartmentChair {
  id           String     @id @default(cuid())
  userId       String     @unique
  departmentId String     @unique

  user         User       @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
}

model Program {
  id           String      @id @default(cuid())
  name         String
  abbreviation String
  departmentId String
  clusterId    String?

  department   Department     @relation(fields: [departmentId], references: [id])
  cluster      FacultyCluster? @relation(fields: [clusterId], references: [id])
  head         ProgramHead?
  yearLevels   YearLevel[]
  faculty      Faculty[]   // faculty assigned to this program
  subjects     Subject[]   // program-specific subjects (null programId = shared/GEC)
  rooms        ProgramRoom[] // rooms restricted to this program (course-level access)
  finalizations ProgramFinalization[] // "done plotting" declarations per schedule

  @@unique([abbreviation, departmentId])
}

model ProgramHead {
  id        String  @id @default(cuid())
  userId    String  @unique
  programId String  @unique

  user      User    @relation(fields: [userId], references: [id])
  program   Program @relation(fields: [programId], references: [id])
}

model YearLevel {
  id        String    @id @default(cuid())
  level     Int
  programId String

  program   Program   @relation(fields: [programId], references: [id])
  sections  Section[]
  subjects  Subject[]

  @@unique([level, programId])
}

model Section {
  id          String          @id @default(cuid())
  name        String
  yearLevelId String
  capacity    Int             @default(40)

  yearLevel        YearLevel         @relation(fields: [yearLevelId], references: [id])
  assignments      ScheduleEntry[]
  unassignedEntries UnassignedEntry[]
}

model Faculty {
  id              String                       @id @default(cuid())
  userId          String                       @unique
  departmentId    String
  programId       String?                      // assigned to a specific program; null = dept-wide pool
  // CAS cluster (Social Sciences / Language, Communication, and Humanities /
  // Mathematics and Natural Sciences) this faculty member primarily belongs to.
  // Null = unassigned, or a non-CAS faculty (clusters only exist within CAS).
  // Lets a cluster chair's write access (checkFacultyWriteAccess) be scoped to
  // their own cluster, not just their (CAS-wide, shared-by-all-3-chairs) department.
  clusterId       String?
  employeeId      String                       @unique
  specializations String[]
  sectionCounts   Json?                        @default("{}") // { "Subject Title": numberOfSections }
  // REGULAR (21 units/week) or COSI (40 units/week) — see FacultyType.
  employmentType  FacultyType                  @default(REGULAR)
  // Derived from employmentType (21 / 40) — never set independently.
  maxUnitsPerWeek Int                          @default(21)
  // Maximum weekly workload in contact HOURS (units above are credit units).
  // Caps both the availability a chair may mark for this faculty and the hours
  // the scheduler / manual entry may assign. Editable on the Faculty
  // Availability page ("Max hours" field).
  maxHoursPerWeek Int                          @default(30)
  hoursPerWeek    Int                          @default(0)
  isActive        Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  user                    User                         @relation(fields: [userId], references: [id])
  department              Department                   @relation(fields: [departmentId], references: [id])
  program                 Program?                     @relation(fields: [programId], references: [id])
  cluster                 FacultyCluster?              @relation(fields: [clusterId], references: [id])
  availability            FacultyAvailability[]
  buildingAvailability    FacultyBuildingAvailability[]
  scheduleEntries         ScheduleEntry[]
  teachingLoads           TeachingLoad[]
}

model FacultyAvailability {
  id         String    @id @default(cuid())
  facultyId  String
  day        DayOfWeek
  startTime  String
  endTime    String
  semesterId String

  faculty    Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  semester   Semester  @relation(fields: [semesterId], references: [id])

  @@unique([facultyId, day, startTime, semesterId])
}

// Records which buildings a faculty member is available to teach in,
// per semester. The algorithm enforces this as a Hard Constraint —
// a faculty member cannot be assigned to a room in a building not listed here.
model FacultyBuildingAvailability {
  id         String    @id @default(cuid())
  facultyId  String
  buildingId String
  semesterId String

  faculty    Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  building   Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  semester   Semester  @relation(fields: [semesterId], references: [id])

  @@unique([facultyId, buildingId, semesterId])
  @@index([facultyId, semesterId])
}

model Building {
  id          String               @id @default(cuid())
  name        String               @unique
  code        String               @unique
  isActive    Boolean              @default(true)

  rooms                Room[]
  departments          DepartmentBuilding[]
  facultyAvailability  FacultyBuildingAvailability[]
}

// Many-to-many: a department may operate across multiple buildings,
// and a building may house multiple departments.
model DepartmentBuilding {
  id           String     @id @default(cuid())
  departmentId String
  buildingId   String

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  building     Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([departmentId, buildingId])
}

model Room {
  id                String             @id @default(cuid())
  name              String
  code              String             @unique
  buildingId        String
  type              RoomType
  // Only populated for LABORATORY / COMPUTER_LAB rooms.
  // Used as a Hard Constraint by the scheduling engine.
  labSpecialization LabSpecialization?
  equipment         String[]
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())

  building        Building        @relation(fields: [buildingId], references: [id])
  scheduleEntries ScheduleEntry[]
  departments     DepartmentRoom[]
  programs        ProgramRoom[]
}

// Per-room department access control.
// Zero entries = unrestricted (any department may use this room).
// One or more entries = only those departments may be scheduled here.
model DepartmentRoom {
  id           String @id @default(cuid())
  departmentId String
  roomId       String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([departmentId, roomId])
}

// Per-room program (course) access control — finer-grained than DepartmentRoom.
// Access semantics (union): a room is open to a section when it has no
// department AND no program entries, OR its departments include the section's
// department, OR its programs include the section's program.
model ProgramRoom {
  id        String @id @default(cuid())
  programId String
  roomId    String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([programId, roomId])
}

model AcademicYear {
  id        String     @id @default(cuid())
  label     String     @unique
  startYear Int
  endYear   Int
  isCurrent Boolean    @default(false)

  semesters Semester[]
}

model Semester {
  id             String      @id @default(cuid())
  type           SemesterType
  academicYearId String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  academicYear        AcademicYear                  @relation(fields: [academicYearId], references: [id])
  schedules           Schedule[]
  availability        FacultyAvailability[]
  buildingAvailability FacultyBuildingAvailability[]
  teachingLoads       TeachingLoad[]
  workflowStates      DepartmentWorkflowState[]

  @@unique([type, academicYearId])
}

model Subject {
  id                       String             @id @default(cuid())
  code                     String
  title                    String
  units                    Int
  hoursPerWeek             Int
  type                     SubjectType
  semester                 SemesterType       @default(FIRST)
  year                     Int                @default(1)
  departmentId             String
  programId                String?            // null = GEC/shared; set = specific to this program
  yearLevelId              String?
  requiredRoomType         RoomType[]
  // When set, the backtracking engine will only match rooms whose
  // labSpecialization equals this value (Hard Constraint).
  requiredLabSpecialization LabSpecialization?
  // Longest single session (minutes) this subject may hold on one day. Null =
  // the default rule in lib/session-rules.ts (GEC/GEL: 90 minutes, i.e. a 3-hour
  // subject meets 1h×3 or 1.5h×2 and is never a 3-hour block; other subjects:
  // no cap). The Department Chairperson can set 60 or 90 per GEC/GEL subject.
  // Hard constraint for both the engine and manual entry.
  maxMinutesPerDay         Int?
  createdAt                DateTime           @default(now())

  department      Department      @relation(fields: [departmentId], references: [id])
  program         Program?        @relation(fields: [programId], references: [id])
  yearLevel       YearLevel?      @relation(fields: [yearLevelId], references: [id])
  scheduleEntries   ScheduleEntry[]
  teachingLoads     TeachingLoad[]
  unassignedEntries UnassignedEntry[]

  @@unique([code, departmentId])
}

model TeachingLoad {
  id         String   @id @default(cuid())
  facultyId  String
  subjectId  String
  semesterId String
  units      Int
  assignedAt DateTime @default(now())

  faculty    Faculty  @relation(fields: [facultyId], references: [id])
  subject    Subject  @relation(fields: [subjectId], references: [id])
  semester   Semester @relation(fields: [semesterId], references: [id])

  @@unique([facultyId, subjectId, semesterId])
}

model Schedule {
  id           String         @id @default(cuid())
  semesterId   String
  departmentId String?
  status       ScheduleStatus @default(DRAFT)
  isArchived   Boolean        @default(false)
  generatedAt  DateTime?
  publishedAt  DateTime?
  // Note from the Dean explaining why this schedule was returned to DRAFT.
  // Cleared on the next submit/approve/reset.
  rejectionReason String?
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  semester   Semester        @relation(fields: [semesterId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id])
  entries    ScheduleEntry[]
  conflicts  ConflictLog[]
  unassigned UnassignedEntry[]

  @@index([departmentId])
  gecFinalizations     GecFinalization[]
  programFinalizations ProgramFinalization[]
}

model ScheduleEntry {
  id           String    @id @default(cuid())
  scheduleId   String
  subjectId    String
  facultyId    String
  // Free-text faculty name typed by the Program Chair. When set, this is
  // displayed instead of the linked faculty record's name.
  facultyName  String?
  roomId       String
  sectionId    String
  day          DayOfWeek
  startTime    String
  endTime      String
  set          String?   // null = LECTURE; "A" or "B" = LABORATORY split groups
  // Shared by all session-rows of one multi-day (MWF/TTh) auto-generated
  // assignment, so PATCH/DELETE can treat them as one logical entry. Null
  // for single-session or manually-added entries.
  groupId      String?
  // Merged NSTP class: two or more sections taught together as ONE class (same
  // subject, faculty, room, day and time). One row per (section, day), all
  // sharing this id. Rows of one merge group are exempt from faculty/room
  // double-booking checks against each other (they ARE the same class), the
  // views collapse them into a single line, and edit/delete act on the whole
  // group. Only the NSTP Director creates these (POST /entries `sectionIds`).
  mergeGroupId String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id])
  faculty  Faculty  @relation(fields: [facultyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  section  Section  @relation(fields: [sectionId], references: [id])

  @@index([scheduleId])
  @@index([facultyId, day])
  @@index([roomId, day])
  @@index([sectionId, day])
  @@index([groupId])
  @@index([mergeGroupId])
}

model UnassignedEntry {
  id         String   @id @default(cuid())
  scheduleId String
  subjectId  String
  sectionId  String
  reason     String?
  // Who ran the generate that produced this row. A schedule can receive
  // multiple generate runs by different chairs (e.g. a CIT schedule gets the
  // Dept Chair's GEC pass, then that program's own major-subject pass) — the
  // Unassigned Queue is scoped to only the chair who caused each failure, not
  // to everyone who can see the schedule. Nullable so pre-existing rows from
  // before this column don't break; only ever null on rows created before it.
  generatedBy String?
  createdAt  DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id])
  section  Section  @relation(fields: [sectionId], references: [id])

  @@index([scheduleId])
  @@index([generatedBy])
  @@map("unassigned_entries")
}

model ConflictLog {
  id          String   @id @default(cuid())
  scheduleId  String
  type        String
  description String
  entityIds   String[]
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

// Tracks the submission/approval lifecycle for each department per semester.
// The SUPER_ADMIN (Department Chair) cannot trigger schedule generation unless
// the ADMIN (Program Chair) has moved status to SUBMITTED_TO_CHAIR.
model DepartmentWorkflowState {
  id           String                   @id @default(cuid())
  departmentId String
  semesterId   String
  status       DepartmentWorkflowStatus @default(DRAFT)
  submittedBy  String?  // userId of the Program Chair who submitted
  submittedAt  DateTime?
  reviewedBy   String?  // userId of the Department Chair who last reviewed
  reviewedAt   DateTime?
  reviewNote   String?  // populated on REJECTED status
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  semester   Semester   @relation(fields: [semesterId], references: [id])

  @@unique([departmentId, semesterId])
  @@index([departmentId, status])
}

// Append-only trail of what people did in the system. Every write route
// records one row (lib/audit.ts). A Dean reads the rows whose departmentId
// (the department the action was ABOUT) or actorDepartmentId (the department
// the actor belongs to) is their own — see GET /api/audit-logs.
model AuditLog {
  id                String   @id @default(cuid())
  actorId           String?
  actorName         String
  actorRole         String
  actorDepartmentId String?
  // Dotted verb, e.g. "schedule.generated", "entry.deleted", "user.approved"
  action            String
  entityType        String
  entityId          String?
  summary           String
  departmentId      String?
  scheduleId        String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([departmentId, createdAt])
  @@index([actorDepartmentId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// A Program Chairperson's request for an instructor when their own program has no
// qualified faculty for a subject. The Department Chairperson answers it by
// ALLOCATING a faculty member (facultyId) to the requesting program for the term
// (semesterId): from then on that faculty is part of the program's candidate pool
// in both the generator and the Add/Edit Entry picker for that term — still
// subject to specialization, availability and building access.
model FacultyRequest {
  id           String    @id @default(cuid())
  requesterId  String
  departmentId String
  programId    String?   // the requesting Program Chairperson's program
  semesterId   String?   // the term the instructor is needed for
  subjectId    String?
  reason       String
  status       String    @default("PENDING") // PENDING, APPROVED, DENIED
  facultyId    String?   // the instructor allocated on approval
  respondedBy  String?
  respondedAt  DateTime?
  responseNote String?
  createdAt    DateTime  @default(now())

  @@index([departmentId, status])
  @@index([requesterId])
  @@index([programId, semesterId, status])
}

model ScheduleSwapRequest {
  id              String    @id @default(cuid())
  requesterId     String
  entryId         String
  requestedRoomId String
  requestedDay    String
  requestedStart  String
  requestedEnd    String
  reason          String
  status          String    @default("PENDING") // PENDING, RESOLVED, DENIED
  respondedBy     String?
  respondedAt     DateTime?
  responseNote    String?
  createdAt       DateTime  @default(now())
  // Lab-change requests (spec Section 2): the Dept Chair asks the owning CIT
  // Program Chair to move a CIT lab that blocks GEC. kind distinguishes these from
  // any future generic swap; scheduleId scopes them; targetUserId is the CIT chair
  // asked to act (may be null when the program has no assigned chair yet).
  kind            String    @default("SWAP") // "SWAP" | "LAB_CHANGE"
  scheduleId      String?
  targetUserId    String?

  @@index([requesterId])
  @@index([status])
  @@index([targetUserId, status])
  @@index([scheduleId])
}
